  "video": {},
  "independent_node_keys": {
    "template": "Hrio_Design_Template_Node",
    "three_view": "Hrio_Design_Three_View_Node",
    "single_image": "Hrio_Design_Single_Image_Node",
    "single_video": "Hrio_Design_Single_Video_Node",
    "video": "Hrio_Design_Video_Node"
