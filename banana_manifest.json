{
  "plugin_version": "8.1.4",
  "schema_version": 1,
  "name": "Hrio-Design",
  "display_name": "Hrio Design 独立设计师节点",
  "description": "Hrio Design 独立插件 v8.1.4：普通单图、普通三方案、普通视频、视频生成节点全部保持手动提示词，不再被模板面板强制覆盖；自动化 payload 仍应用到所有带 automation_payload 的节点。",
  "config_defaults": {
    "manifest_url": "https://wen.tenx-jingli.cloud/plugins2/hrio_design_manifest.json",
    "base_url": "https://zheshihouduan.tenx-jingli.cloud/api/",
    "fallback_base_url": "https://zheshihouduan.tenx-jingli.cloud/api",
    "model": "banano",
    "image_size": "2k",
    "aspect_ratio": "Auto",
    "verify_ssl": "false",
    "connect_timeout_sec": "30",
    "read_timeout_sec": "300",
    "upload_dir": "shortlinks/qr",
    "enable_oss": "true",
    "compress_images": "true",
    "force_hd": "true",
    "max_retry_per_view": "8",
    "retry_interval_sec": "1.5",
    "veo_poll_interval_sec": "8",
    "veo_poll_timeout_sec": "1800",
    "veo_resolution": "1080p",
    "veo_duration_seconds": "8",
    "veo_number_of_videos": "1"
  },
  "node": {
