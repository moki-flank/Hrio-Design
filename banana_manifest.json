      "室内｜室内氛围渲染": "interior_mood_render",
      "室内｜材质情绪板": "material_moodboard",
      "室内｜软装搭配方案": "soft_furnishing_plan",
      "室内｜墙面 / 地面材质替换": "material_replacement",
      "室内｜灯光氛围调整": "lighting_mood"
    },
    "default_prompt_template": "平面｜品牌主视觉 KV",
    "default_mode": "平面｜品牌主视觉 KV",
    "default_model": "banano2",
    "default_image_size": "4K",
    "default_aspect_ratio": "16:9 (横屏宽幅)"
